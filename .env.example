# Use este arquivo apenas para testar o compose fora do Coolify:
#   cp .env.example .env
#   docker compose up -d
#
# No Coolify, NÃO comite .env: cadastre as variáveis em
# Application > Environment Variables.

# URL pública do painel/API/relay. NÃO inclua a porta interna :8080.
# O domínio do Coolify deve apontar para o serviço `wm` na porta 8080.
WM_PUBLIC_URL=https://mesh.exemplo.com

# Senha inicial do usuário `admin`. Só é aplicada no primeiro start; depois
# disso, trocar a variável não altera a senha já gravada no SQLite.
WM_ADMIN_PASSWORD=troque-por-uma-senha-forte-e-guarde

# Nome do nó gateway que o host inscreve automaticamente na malha (.1).
WM_NODE_NAME=gateway

# Nível de log do processo: trace, debug, info, warn ou error.
WM_LOG=info
