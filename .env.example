# Use este arquivo apenas para testar o compose fora do Coolify:
#   cp .env.example .env
#   docker compose up -d
#
# No Coolify, NÃO comite .env: cadastre as variáveis em
# Application > Environment Variables.

# URL pública do painel/API/relay. NÃO inclua a porta HTTP interna.
# O domínio/proxy do Coolify deve apontar para `wm` na porta WM_HTTP_PORT.
WM_PUBLIC_URL=https://mesh.exemplo.com

# HTTP interno (sem publicação TCP); configure esta porta no proxy do Coolify.
WM_HTTP_PORT=8080

# UDP publicado diretamente, com a mesma porta dentro e fora do container.
# Libere estas portas no firewall; não remapeie só o lado externo.
WM_STUN_PORT=3478
WM_UDP_PORT=41641

# Conta temporária de setup (não é admin). Use senha única de 12+ caracteres.
# Primeiro acesso: wm admin --server https://mesh.exemplo.com tui
# A TUI cria admin + usuário e invalida o bootstrap. Remova estas variáveis depois.
# Mantê-las não reabre setup nem troca senhas; preserve o volume SQLite.
WM_BOOTSTRAP_USERNAME=setup
WM_BOOTSTRAP_PASSWORD=troque-por-uma-senha-temporaria-unica

# Nome do nó gateway que o host inscreve automaticamente na malha (.1).
WM_NODE_NAME=gateway

# Nível de log do processo: trace, debug, info, warn ou error.
WM_LOG=info
